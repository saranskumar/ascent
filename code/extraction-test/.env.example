# ==============================================================================
# Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API Key
# ------------------------------------------------------------------------------
# Purpose: Used in Step (b) and server for multimodal visual meeting summarization.
#
# How to get it:
#   1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
#   2. Sign in with your Google Account.
#   3. Click "Create API Key" (or select an existing project with Gemini quota).
#   4. Copy the generated key string (starts with AQ... or AIza...).
#   5. Paste it below as GEMINI_API_KEY.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default model used for summarization (defaults to gemini-2.5-flash or gemini-3.8-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Fallback model if main model hits 503 overload errors
GEMINI_FALLBACK_MODEL=gemini-3.5-flash


# ------------------------------------------------------------------------------
# 2. Meetily Pro API Token
# ------------------------------------------------------------------------------
# Purpose: Used in Step (c) to write the visual summary back into Meetily (PUT summary)
#          and rename meetings. Standard reads use Meetily's local loopback token.
#
# How to get it:
#   1. Open the Meetily Pro desktop application.
#   2. Ensure the local gateway is enabled:
#      - Go to Settings > Integrations.
#      - Toggle ON "Allow the CLI on this computer" (starts gateway on 127.0.0.1:8420).
#   3. Generate an API Key:
#      - Go to Settings > Integrations > Apps & scripts.
#      - Click "Create key".
#      - Enter a label (e.g., "visual-copilot" or "key1").
#      - Check the required scopes: at least `write` (and `read`, `record` if needed).
#      - Click Create and copy the token string immediately (it will not be shown again).
#   4. CRITICAL STEP:
#      - In the "Apps & scripts" list, turn ON the "Allow" / toggle switch next to your key.
#        If left disabled, Meetily will reject requests with "consumer_disabled" / 401 unauthorized.
#   5. Paste the token below as MEETILY_PRO_TOKEN.
MEETILY_PRO_TOKEN=your_meetily_pro_token_here
