# Copy to .env (gitignored). Real environment variables win over this file.
# Everything else (model, device, automation...) is in the app's Settings tab.

# Meetily write key: lets the app put the summary into Meetily (reads use Meetily's
# read-only loopback token automatically).
#   Meetily > Settings > Integrations > Apps & scripts > Create key, tick the `write` scope,
#   copy the token, and switch the key's Allow toggle ON (otherwise: "consumer_disabled").
MEETILY_PRO_TOKEN=

# Optional: Meetily's local API address (default http://127.0.0.1:8420)
# MEETILY_API=http://127.0.0.1:8420
