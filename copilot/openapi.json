          "meeting_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string"
          },
          "process_id": {
            "type": "string"
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "type": "string"
          },
          "status_url": {
            "type": "string"
          },
          "wait_url": {
            "type": "string"
          }
