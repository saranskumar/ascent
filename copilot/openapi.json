  "components": {
    "schemas": {
      "ConfigDto": {
        "type": "object",
        "description": "GET /v1/config/{section} (T-10). `config` is the section's live value\nexactly as the desktop UI's own `get_*_config` Tauri command already\nreturns it (defaults merged with the on-disk file) - see \"## T-10 NOTES\"\nfor the section-name map and why this ended up app-state-based rather\nthan pool-based.",
        "required": [
          "section",
          "config",
          "withheld"
        ],
        "properties": {
          "config": {
            "type": "object"
          },
          "section": {
            "type": "string"
          },
          "withheld": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "T59: the field paths withheld from `config` on this read (each one is\npresent in `config` carrying the `[withheld]` marker). Empty for every\nsection today - a held-back field is LISTED here, never silently\ndropped, so a client can tell \"withheld\" from \"unset\"."
          }
        }
      },
